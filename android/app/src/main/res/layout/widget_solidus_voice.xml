<?xml version="1.0" encoding="utf-8"?>
<!-- One button, one job: the whole panel is the tap target. A plain text
     glyph rather than a vector icon, the same way the keypad widget's own
     "+"/"−" buttons are: one fewer asset to keep in step with the app's
     icon set, and universally renderable. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_voice_button"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:gravity="center"
    android:text="@string/w_voice_glyph"
    android:textColor="@color/w_ink"
    android:textSize="13sp"
    android:contentDescription="@string/w_voice_action" />
