<?xml version="1.0" encoding="utf-8"?>
<!-- One grid of quarters, top to bottom. The chip and the two action
     buttons take a quarter each, which is exactly what a key takes, so
     every button in the widget is the same size without any of them being
     given a fixed dp. The keypad is laid out the way a calculator is:
     digits in three rows of three, and a fourth column for the three
     things that edit rather than add. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_panel"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/w_expense_amount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/widget_field"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:ellipsize="start"
            android:textColor="@color/w_ink"
            android:textSize="14sp"
            android:contentDescription="@string/w_expense_action" />

        <ImageView
            android:id="@+id/w_category"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_chip"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/w_category_action" />

        <TextView
            android:id="@+id/w_add_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_expense"
            android:gravity="center"
            android:text="@string/w_minus"
            android:textColor="@color/w_on_button"
            android:textSize="14sp"
            android:contentDescription="@string/w_expense_action" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/w_income_amount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/widget_field"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:ellipsize="start"
            android:textColor="@color/w_ink"
            android:textSize="14sp"
            android:contentDescription="@string/w_income_action" />

        <TextView
            android:id="@+id/w_add_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_income"
            android:gravity="center"
            android:text="@string/w_plus"
            android:textColor="@color/w_on_button"
            android:textSize="14sp"
            android:contentDescription="@string/w_income_action" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/w_key_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_del"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="⌫"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/w_key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="6"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="C"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/w_key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="7"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="9"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_zeros"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="000"
            android:textColor="@color/w_ink"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/w_key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_key_dot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_key"
            android:gravity="center"
            android:text="·"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
