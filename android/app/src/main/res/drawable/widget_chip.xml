<?xml version="1.0" encoding="utf-8"?>
<!-- A widget view with a click intent does take the pressed state, so a
     state list is all it needs to answer a tap. Without one a key looks
     identical whether or not it registered, which is the one thing a
     keypad must never be ambiguous about. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_gold_press" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/w_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_gold_fill" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/w_gold" />
        </shape>
    </item>
</selector>
