<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android paints before Flutter's first frame. Ivory, with
     the mark centred, so the app opens on its own brand rather than a white
     flash that belongs to no theme. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/brand_mark" />
    </item>
</layer-list>
