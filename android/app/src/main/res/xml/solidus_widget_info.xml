<?xml version="1.0" encoding="utf-8"?>
<!-- Six rows now rather than four, since the keypad is a calculator. The
     floor is what those rows need at 13sp; a launcher will happily let a
     widget be dragged below what its layout can draw, and the digits would
     start clipping. Anything larger is the user's own choice. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_solidus"
    android:previewLayout="@layout/widget_solidus"
    android:description="@string/w_widget_description"
    android:minWidth="140dp"
    android:minHeight="170dp"
    android:minResizeWidth="130dp"
    android:minResizeHeight="160dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="520dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
