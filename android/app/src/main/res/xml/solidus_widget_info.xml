<?xml version="1.0" encoding="utf-8"?>
<!-- Smaller again by about a third. The floor is what four rows of 13sp
     text actually need: below it the digits start clipping, and a launcher
     will happily let a widget be dragged there. Anything larger is the
     user's own choice. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_solidus"
    android:previewLayout="@layout/widget_solidus"
    android:description="@string/w_widget_description"
    android:minWidth="150dp"
    android:minHeight="120dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="420dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
