<?xml version="1.0" encoding="utf-8"?>
<!-- Five rows rather than six, asked for in two cells of width rather than
     three. minHeight is the floor the text sets, not a preference: five
     rows of 13 and 14sp need about this much, and a launcher will let a
     widget be dragged below what its layout can draw, at which point the
     digits clip. Stretching past it is free. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_solidus"
    android:previewLayout="@layout/widget_solidus"
    android:description="@string/w_widget_description"
    android:minWidth="115dp"
    android:minHeight="136dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="130dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="520dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
