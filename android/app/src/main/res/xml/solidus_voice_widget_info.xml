<?xml version="1.0" encoding="utf-8"?>
<!-- A single square cell by default: this widget is one button, not a
     panel of controls, so it has none of the keypad widget's need for
     room to grow. Still resizable, for anyone who drags it larger anyway. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_solidus_voice"
    android:previewLayout="@layout/widget_solidus_voice"
    android:description="@string/w_voice_widget_description"
    android:minWidth="60dp"
    android:minHeight="60dp"
    android:minResizeWidth="50dp"
    android:minResizeHeight="50dp"
    android:maxResizeWidth="200dp"
    android:maxResizeHeight="200dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
